    {
      "id": "R1",
      "category": "definition",
      "question": "What counts as a late shipment?",
      "kind": "definition",
      "needs": "rag",
      "answer_text": "A shipment is late if it has been delivered and its actual arrival is after its planned arrival. A shipment that has not arrived yet is not counted as late; if its planned arrival has passed it is 'currently delayed' instead.",
      "note": ""
    },
    {
      "id": "R2",
      "category": "definition",
      "question": "How is on-time delivery calculated?",
      "kind": "definition",
      "needs": "rag",
      "answer_text": "On-time rate = on-time deliveries divided by delivered shipments, times 100. A shipment is on time if it was delivered at or before its planned arrival. Shipments that have not arrived are never on time and are not in the denominator.",
      "note": ""
    },
    {
      "id": "R3",
      "category": "definition",
      "question": "What does is_deleted mean?",
      "kind": "definition",
      "needs": "rag",
      "answer_text": "A silver-layer flag set when the source row was deleted in PostgreSQL. Deleted rows are kept in silver but left out of gold.",
      "note": ""
    },
